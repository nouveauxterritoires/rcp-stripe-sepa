# Dépendances
/vendor/
/node_modules/

# Sources et archives propriétaires (Restrict Content Pro) — ne jamais versionner.
# RCP Pro est un produit commercial : ni son archive ni son code ne doivent
# entrer dans ce dépôt.
/vendor-plugins/
!/vendor-plugins/.gitkeep
/ressources/
/restrict-content-pro/
/**/restrict-content-pro/

# Secrets et configuration locale
.env
.env.*
!.env.example
*.pem
*.key

# Artefacts de build et de test
/assets/js/dist/
/tests/coverage/
/tests/results/
/playwright-report/
/test-results/
.phpunit.result.cache
.phpcs-cache
/build/
*.zip

# Environnement local
/.idea/
/.vscode/
.DS_Store
*.log

# OMC
/.omc/
