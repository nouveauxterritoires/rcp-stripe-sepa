<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
    bootstrap="tests/bootstrap.php"
    colors="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
    beStrictAboutOutputDuringTests="true"
    failOnWarning="true"
    failOnRisky="true"
    convertDeprecationsToExceptions="true">

    <testsuites>
        <!-- WordPress mocké (Brain Monkey) : rapide, sans base de données. -->
        <testsuite name="unit">
            <directory suffix="Test.php">tests/unit</directory>
        </testsuite>
        <!-- WordPress et RCP réels, API Stripe bouchonnée. -->
        <testsuite name="integration">
            <directory suffix="Test.php">tests/integration</directory>
        </testsuite>
        <!-- Contrats : schéma Stripe (stripe-mock) et API interne de RCP. -->
        <testsuite name="contract">
            <directory suffix="Test.php">tests/contract</directory>
        </testsuite>
        <!-- Webhooks : signature, idempotence, désordre, livemode. -->
        <testsuite name="webhooks">
            <directory suffix="Test.php">tests/webhooks</directory>
        </testsuite>
    </testsuites>

    <!-- Les rapports sont demandés explicitement en ligne de commande
         (`make coverage`), afin qu'une suite ciblée n'affiche pas un taux
         partiel trompeur. -->
    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </coverage>

    <php>
        <env name="WP_TESTS_DIR" value="/wp-tests/lib"/>
        <env name="STRIPE_MOCK_HOST" value="stripe-mock"/>
        <env name="STRIPE_MOCK_PORT" value="12111"/>
    </php>
</phpunit>
