#: src/Compat/RequirementsNotice.php:90
msgid "SEPA Direct Debit for Restrict Content Pro: the plugin is inactive."
msgstr "Prélèvement SEPA pour Restrict Content Pro : le plugin est inactif."

#: src/Compat/RequirementsNotice.php:103
msgid "Restrict Content is running in legacy mode, which has no payment gateway at all. Switch to the full version in the Restrict Content settings to enable SEPA Direct Debit."
msgstr "Restrict Content fonctionne en mode « legacy », qui ne comporte aucune passerelle de paiement. Basculez sur la version complète dans les réglages de Restrict Content pour activer le prélèvement SEPA."

#: src/Compat/RequirementsNotice.php:115
msgid "Restrict Content Pro (or Restrict Content) must be installed and active to use SEPA Direct Debit."
msgstr "Restrict Content Pro (ou Restrict Content) doit être installé et actif pour utiliser le prélèvement SEPA."

#. translators: 1: required version, 2: detected version.
#: src/Compat/RequirementsNotice.php:134
#, php-format
msgid "Restrict Content Pro %1$s or later is required; version %2$s is installed."
msgstr "Restrict Content Pro %1$s ou supérieur est requis ; la version %2$s est installée."

#. translators: %s: minimum Stripe SDK version.
#: src/Compat/RequirementsNotice.php:157
#, php-format
msgid "The Stripe SDK shipped with Restrict Content Pro could not be found. Version %s or later is required."
msgstr "Le SDK Stripe fourni par Restrict Content Pro est introuvable. La version %s ou supérieure est requise."

#. translators: 1: required version, 2: detected version.
#: src/Compat/RequirementsNotice.php:164
#, php-format
msgid "The Stripe SDK shipped with Restrict Content Pro is too old: version %1$s or later is required, %2$s was found. Please update Restrict Content Pro."
msgstr "Le SDK Stripe fourni par Restrict Content Pro est trop ancien : version %1$s ou supérieure requise, %2$s détectée. Mettez Restrict Content Pro à jour."

#. translators: %s: comma-separated list of missing items.
#: src/Compat/RequirementsNotice.php:193
#, php-format
msgid "This version of Restrict Content Pro no longer exposes what the plugin relies on: %s. Please report this incompatibility to the plugin maintainer."
msgstr "Cette version de Restrict Content Pro n'expose plus les éléments attendus par le plugin : %s. Signalez cette incompatibilité au mainteneur du plugin."

