# Copier ce fichier vers .env et compléter. .env n'est jamais versionné.

# --- Environnement -----------------------------------------------------------
PHP_VERSION=8.2
WP_VERSION=latest
RCP_VERSION=latest
WP_PORT=8080
MAILPIT_PORT=8025
STRIPE_MOCK_PORT=12111

# --- Base de données (développement uniquement) ------------------------------
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# --- Stripe : CLÉS DE TEST UNIQUEMENT ----------------------------------------
# N'utilisez JAMAIS de clé sk_live_* dans ce fichier.
STRIPE_TEST_SECRET_KEY=sk_test_VOTRE-CLE-SECRETE-DE-TEST
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_VOTRE-CLE-PUBLIABLE-DE-TEST

# Fourni par `stripe listen` (whsec_...). Voir `make stripe-listen`.
STRIPE_WEBHOOK_SECRET=whsec_VOTRE-SECRET-DE-WEBHOOK
